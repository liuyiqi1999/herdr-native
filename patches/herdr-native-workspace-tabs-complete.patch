+fn repeated_workspace_keys_advance_before_remote_snapshot_arrives() {
+    let (mut state, remote) = state_with_remote();
+    let config: Config =
+        toml::from_str("[keys]\nnext_workspace = 'super+down'\nprevious_workspace = 'super+up'")
+            .unwrap();
+    state.config = ClientShellConfig::from_config(&config);
+    let mut projection = snapshot();
+    projection.boot_id = "remote-boot".into();
+    for number in 2..=4 {
+        let mut workspace = projection.workspaces[0].clone();
+        workspace.workspace_id = format!("ws_{number}");
+        workspace.number = number;
+        workspace.focused = false;
+        projection.workspaces.push(workspace);
+    }
+    state.set_endpoint_snapshot(&remote, Box::new(projection));
+    assert!(state.activate_endpoint_projection(&remote));
+    let mut commands = crate::client::endpoint_commands::EndpointCommands::default();
+    // No server updates between keypresses: model a slow SSH round trip.
+    for (key, expected) in [
+        (KeyCode::Down, "ws_2"),
+        (KeyCode::Down, "ws_3"),
+        (KeyCode::Up, "ws_2"),
+        (KeyCode::Down, "ws_3"),
+        (KeyCode::Down, "ws_4"),
+    ] {
+        let outcome = state.handle_raw_events(vec![RawInputEvent::Key(
+            crate::input::TerminalKey::new(key, KeyModifiers::SUPER),
+        )]);
+        assert!(
+            matches!(outcome.actions.as_slice(),
+            [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::WorkspaceFocus(target)
+                if target.workspace_id == expected)),
+            "expected {expected}"
+        );
+        assert!(
+            outcome.repaint,
+            "navigation should immediately repaint its selection"
+        );
+        assert_eq!(
+            state
+                .pending_workspace_highlight
+                .as_ref()
+                .unwrap()
+                .target
+                .workspace_id,
+            expected
+        );
+        for action in outcome.actions {
+            if let ClientShellAction::Endpoint {
+                endpoint_id,
+                boot_id,
+                request,
+            } = action
+            {
+                if let Some(id) = commands.enqueue(endpoint_id, 1, boot_id, request) {
+                    state.supersede_workspace_request(&id);
+                }
+            }
+        }
+        assert_eq!(state.pending_requests.len(), 1);
+        assert!(state.visible_endpoint_notice.is_none());
+    }
+}

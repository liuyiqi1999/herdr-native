+use super::*;
+
+#[test]
+fn workspace_tabs_include_shells_and_collapse_split_panes() {
+    let mut snapshot = snapshot();
+    let mut split = snapshot.panes[0].clone();
+    split.pane_id = "split".into();
+    split.focused = false;
+    snapshot.panes.push(split);
+    let mut workspace = snapshot.workspaces[0].clone();
+    workspace.workspace_id = "ws_2".into();
+    workspace.label = "second".into();
+    workspace.focused = false;
+    snapshot.workspaces.push(workspace);
+    let mut tab = snapshot.tabs[0].clone();
+    tab.workspace_id = "ws_2".into();
+    tab.tab_id = "tab_2".into();
+    snapshot.tabs.push(tab);
+    let mut pane = snapshot.panes[0].clone();
+    pane.workspace_id = "ws_2".into();
+    pane.tab_id = "tab_2".into();
+    pane.pane_id = "pane_2".into();
+    snapshot.panes.push(pane);
+    let mut rows = Vec::new();
+    tab_sidebar::append_rows(&mut rows, &snapshot, None, true);
+    assert_eq!(rows.len(), 4, "one header and one tab per workspace");
+    assert!(rows[0].pane_id.is_none());
+    assert_eq!(rows[1].pane_id.as_deref(), Some("pane_1"));
+    assert!(rows[2].pane_id.is_none());
+    assert_eq!(rows[3].pane_id.as_deref(), Some("pane_2"));
+    let config = ClientShellConfig::from_config(&Config::default());
+    let area = Rect::new(0, 0, 40, 10);
+    let mut buffer = Buffer::empty(area);
+    let mut hits = ShellHitMap::default();
+    tab_sidebar::render(&mut buffer, area, &rows, &config, &mut 0, &mut hits);
+    assert_eq!(hits.agents.len(), 2);
+    assert_eq!(hits.agents[0].0.height, 1);
+    assert_eq!(hits.agents[0].0.y, 3);
+    assert_eq!(hits.agents[1].0.y, 5);
+    assert!(hits.agent_sort_toggle.is_empty());
+}
+
+#[test]
+fn workspace_tabs_scroll_and_keep_click_targets_aligned() {
+    let mut snapshot = snapshot();
+    for number in 2..=15 {
+        let mut tab = snapshot.tabs[0].clone();
+        tab.tab_id = format!("tab_{number}");
+        tab.focused = false;
+        snapshot.tabs.push(tab);
+        let mut pane = snapshot.panes[0].clone();
+        pane.tab_id = format!("tab_{number}");
+        pane.pane_id = format!("pane_{number}");
+        pane.focused = false;
+        snapshot.panes.push(pane);
+    }
+    let mut rows = Vec::new();
+    tab_sidebar::append_rows(&mut rows, &snapshot, None, true);
+    let config = ClientShellConfig::from_config(&Config::default());
+    let area = Rect::new(0, 0, 40, 7);
+    let mut buffer = Buffer::empty(area);
+    let mut hits = ShellHitMap::default();
+    let mut scroll = 12;
+    tab_sidebar::render(&mut buffer, area, &rows, &config, &mut scroll, &mut hits);
+    assert!(!hits.agent_scrollbar.is_empty());
+    assert_eq!(hits.agents.len(), 5);
+    assert_eq!(hits.agents.last().unwrap().1, "pane_15");
+    assert!(hits
+        .agents
+        .iter()
+        .all(|(rect, _)| rect.height == 1 && rect.y < area.bottom()));
+}

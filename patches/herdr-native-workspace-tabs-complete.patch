+++ b/src/client/shell/tab_sidebar.rs
@@ -0,0 +1,160 @@
+use ratatui::{
+    text::Line,
+    widgets::{Paragraph, Widget},
+};
+
+use super::*;
+
+pub(super) struct TabSidebarRow {
+    pub endpoint_id: Option<ClientEndpointId>,
+    pub pane_id: Option<String>,
+    label: String,
+    status: Option<crate::api::schema::AgentStatus>,
+    focused: bool,
+    stale: bool,
+}
+
+pub(super) fn append_rows(
+    rows: &mut Vec<TabSidebarRow>,
+    snapshot: &ClientShellSnapshot,
+    endpoint: Option<&ClientShellEndpoint>,
+    active: bool,
+) {
+    let endpoint_id = endpoint.map(|endpoint| endpoint.endpoint_id.clone());
+    let stale = endpoint.is_some_and(|endpoint| endpoint.status != ClientEndpointStatus::Online);
+    for workspace in &snapshot.workspaces {
+        let tabs = snapshot
+            .tabs
+            .iter()
+            .filter(|tab| tab.workspace_id == workspace.workspace_id);
+        let mut group = Vec::new();
+        for tab in tabs {
+            let pane = snapshot
+                .panes
+                .iter()
+                .filter(|pane| {
+                    pane.workspace_id == workspace.workspace_id && pane.tab_id == tab.tab_id
+                })
+                .max_by_key(|pane| pane.focused);
+            group.push(TabSidebarRow {
+                endpoint_id: endpoint_id.clone(),
+                pane_id: pane.map(|pane| pane.pane_id.clone()),
+                label: super::render::tab_label(tab, snapshot),
+                status: Some(tab.agent_status),
+                focused: active && workspace.focused && tab.focused,
+                stale,
+            });
+        }
+        if group.is_empty() {
+            continue;
+        }
+        rows.push(TabSidebarRow {
+            endpoint_id: endpoint_id.clone(),
+            pane_id: None,
+            label: endpoint.map_or_else(
+                || format!(" {}", workspace.label),
+                |endpoint| format!(" {} · {}", endpoint.label, workspace.label),
+            ),
+            status: None,
+            focused: false,
+            stale,
+        });
+        rows.extend(group);
+    }
+}
+
+pub(super) fn endpoint_rows(
+    endpoints: &[ClientShellEndpoint],
+    active_endpoint_id: &ClientEndpointId,
+) -> Vec<TabSidebarRow> {
+    let mut rows = Vec::new();
+    for endpoint in endpoints {
+        if let Some(snapshot) = endpoint.snapshot.as_deref() {
+            append_rows(
+                &mut rows,
+                snapshot,
+                Some(endpoint),
+                &endpoint.endpoint_id == active_endpoint_id,
+            );
+        }
+    }
+    rows
+}
+
+pub(super) fn render(
+    buffer: &mut Buffer,
+    area: Rect,
+    rows: &[TabSidebarRow],
+    config: &ClientShellConfig,
+    scroll: &mut usize,
+    hits: &mut ShellHitMap,
+) {
+    if area.height < 2 {
+        return;
+    }
+    Paragraph::new("─".repeat(area.width as usize))
+        .style(Style::default().fg(config.palette.surface_dim))
+        .render(Rect::new(area.x, area.y, area.width, 1), buffer);
+    Paragraph::new(" tabs · workspaces")
+        .style(
+            Style::default()
+                .fg(config.palette.overlay0)
+                .add_modifier(Modifier::BOLD),
+        )
+        .render(Rect::new(area.x, area.y + 1, area.width, 1), buffer);
+    hits.agent_sort_toggle = Rect::default();
+    super::agent_sidebar::render_agent_list(
+        buffer,
+        area,
+        rows,
+        Some(" no tabs"),
+        config,
+        scroll,
+        hits,
+        0,
+        |_| 1,
+        |buffer, rect, row, hits| {
+            let mut style = Style::default().fg(config.palette.subtext0);
+            if row.focused {
+                style = style
+                    .bg(config.palette.active_row_bg)
+                    .fg(config.palette.text)
+                    .add_modifier(Modifier::BOLD);
+            }
+            if row.stale {
+                style = style
+                    .fg(config.palette.overlay0)
+                    .add_modifier(Modifier::DIM);
+            }
+            let line = match row.status {
+                Some(status) => Line::from(vec![
+                    ratatui::text::Span::raw("   "),
+                    ratatui::text::Span::styled(
+                        status_icon(status, config.status_indicators),
+                        Style::default().fg(if row.stale {
+                            config.palette.overlay0
+                        } else {
+                            status_color(status, &config.palette)
+                        }),
+                    ),
+                    ratatui::text::Span::raw(format!(" {}", row.label)),
+                ]),
+                None => {
+                    style = style
+                        .fg(config.palette.overlay0)
+                        .add_modifier(Modifier::BOLD);
+                    Line::from(row.label.as_str())
+                }
+            };
+            Paragraph::new(line).style(style).render(rect, buffer);
+            if let Some(pane_id) = &row.pane_id {
+                if let Some(endpoint_id) = &row.endpoint_id {
+                    hits.endpoint_agents
+                        .push((rect, endpoint_id.clone(), pane_id.clone()));
+                } else {
+                    hits.agents.push((rect, pane_id.clone()));
+                }
+            }
+        },
+    );
+}

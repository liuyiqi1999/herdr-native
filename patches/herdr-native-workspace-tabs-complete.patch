@@ -0,0 +1,95 @@
+use super::*;
+
+#[test]
+fn native_agent_open_captures_remote_context_without_sending_terminal_input() {
+    let (mut state, remote) = state_with_remote();
+    assert!(state.activate_endpoint_projection(&remote));
+    let mut outcome = ClientShellInput::default();
+    state.prepare_native_agent(
+        "pi",
+        "/Applications/Herdr Native.app/Contents/MacOS/herdr-remote",
+        &mut outcome,
+    );
+    assert!(outcome.requests.is_empty());
+    assert!(outcome
+        .actions
+        .iter()
+        .all(|action| !matches!(action, ClientShellAction::Endpoint { .. })));
+    assert_eq!(state.active_endpoint_id, remote);
+    assert!(!outcome.actions.iter().any(|action| matches!(
+        action,
+        ClientShellAction::ActivateEndpoint {
+            endpoint_id: ClientEndpointId::Local,
+            ..
+        }
+    )));
+    let Some(ClientShellAction::OpenNativeAgent { launcher, args }) = outcome.actions.last() else {
+        panic!("expected local launch")
+    };
+    assert_eq!(
+        launcher,
+        "/Applications/Herdr Native.app/Contents/MacOS/herdr-remote"
+    );
+    assert_eq!(
+        args,
+        &[
+            "open",
+            "--agent",
+            "pi",
+            "--machine",
+            "0123456789abcdef0123456789abcdef",
+            "--cwd",
+            "/repo"
+        ]
+    );
+    assert!(state.pending_requests.is_empty());
+}
+
+#[test]
+fn claude_opens_in_remote_workspace_without_touching_existing_terminal() {
+    let (mut state, remote) = state_with_remote();
+    assert!(state.activate_endpoint_projection(&remote));
+    let mut outcome = ClientShellInput::default();
+    state.prepare_native_agent("claude", "/launcher", &mut outcome);
+    assert_eq!(state.active_endpoint_id, remote);
+    assert!(outcome.requests.is_empty());
+    assert!(state.pending_requests.is_empty());
+    let Some(ClientShellAction::OpenNativeAgent { args, .. }) = outcome.actions.last() else {
+        panic!("expected Claude launch")
+    };
+    assert_eq!(
+        args,
+        &[
+            "open",
+            "--agent",
+            "claude",
+            "--machine",
+            "0123456789abcdef0123456789abcdef",
+            "--cwd",
+            "/repo"
+        ]
+    );
+}
+
+#[test]
+fn native_agent_does_not_fall_back_to_a_remote_pane_if_local_is_offline() {
+    let (mut state, remote) = state_with_remote();
+    assert!(state.activate_endpoint_projection(&remote));
+    state.set_endpoint_status(&ClientEndpointId::Local, ClientEndpointStatus::Reconnecting);
+    let mut outcome = ClientShellInput::default();
+    state.prepare_native_agent("codex", "/launcher", &mut outcome);
+    assert!(outcome.actions.is_empty());
+    assert_eq!(state.active_endpoint_id, remote);
+}
+
+#[test]
+fn native_agent_local_view_does_not_mistake_local_cwd_for_remote_project() {
+    let (mut state, _) = state_with_remote();
+    assert!(state.activate_endpoint_projection(&ClientEndpointId::Local));
+    let mut outcome = ClientShellInput::default();
+    state.prepare_native_agent("codex", "/launcher", &mut outcome);
+    let Some(ClientShellAction::OpenNativeAgent { args, .. }) = outcome.actions.last() else {
+        panic!("expected local launch")
+    };
+    assert_eq!(args, &["open", "--agent", "codex"]);
+}
diff --git a/src/client/shell/tests/new_tab_command.rs b/src/client/shell/tests/new_tab_command.rs
new file mode 100644
index 0000000..2bcf3c7
--- /dev/null
+++ b/src/client/shell/tests/new_tab_command.rs
@@ -0,0 +1,183 @@
+use super::*;
+use crate::api::schema::{Method, ResponseResult, TabCreateParams, TabInfo};
+
+fn created_tab() -> ResponseResult {
+    let ResponseResult::PaneInfo { mut pane } = pane_scroll_result(0, 0, 20) else {
+        unreachable!()
+    };
+    pane.pane_id = "new-pane".into();
+    pane.tab_id = "new-tab".into();
+    ResponseResult::TabCreated {
+        tab: TabInfo {
+            tab_id: "new-tab".into(),
+            workspace_id: "ws_1".into(),
+            number: 2,
+            label: "new".into(),
+            focused: true,
+            pane_count: 1,
+            agent_status: crate::api::schema::AgentStatus::Unknown,
+        },
+        root_pane: pane,
+    }
+}
+
+fn create_request(command: &str, prompt: bool) -> (ClientShellState, String) {
+    let config: Config = toml::from_str(&format!(
+        "[ui]\nnew_tab_command = {command:?}\nprompt_new_tab_name = {prompt}"
+    ))
+    .unwrap();
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_endpoint_methods(Some(
+        crate::server::client_commands::supported_client_shell_method_names()
+            .iter()
+            .map(|name| (*name).to_owned())
+            .collect(),
+    ));
+    state.set_pane_surface(surface());
+    let mut outcome = ClientShellInput::default();
+    state.record_binding(
+        crate::input::KeybindMatch::Action(crate::input::KeybindAction::NewTab),
+        &mut outcome,
+    );
+    if prompt {
+        assert!(outcome.actions.is_empty());
+        outcome = state.handle_input_bytes(b"\r");
+    }
+    let [ClientShellAction::Endpoint { request, .. }] = &outcome.actions[..] else {
+        panic!("expected tab creation");
+    };
+    assert!(matches!(
+        request.method,
+        Method::TabCreate(TabCreateParams { .. })
+    ));
+    let id = request.id.clone();
+    (state, id)
+}
+
+#[test]
+fn new_tab_command_runs_once_in_returned_pane_with_or_without_name_prompt() {
+    for prompt in [false, true] {
+        let (mut state, id) = create_request("pi --continue", prompt);
+        let (_, actions) = state.handle_endpoint_result("boot-1", &id, Ok(created_tab()));
+        let [ClientShellAction::Endpoint { request, .. }] = &actions[..] else {
+            panic!("expected startup command");
+        };
+        assert!(matches!(&request.method, Method::PaneSendInput(params)
+            if params.pane_id == "new-pane" && params.text == "pi --continue"
+                && params.keys == ["Enter"]));
+        assert!(state
+            .handle_endpoint_result("boot-1", &id, Ok(created_tab()))
+            .1
+            .is_empty());
+    }
+}
+
+#[test]
+fn new_tab_command_disabled_failed_and_stale_requests_do_not_execute() {
+    for command in ["", "   "] {
+        let (mut state, id) = create_request(command, false);
+        assert!(state
+            .handle_endpoint_result("boot-1", &id, Ok(created_tab()))
+            .1
+            .is_empty());
+    }
+    let (mut state, id) = create_request("pi", false);
+    assert!(state
+        .handle_endpoint_result("other-boot", &id, Ok(created_tab()))
+        .1
+        .is_empty());
+    let (mut state, id) = create_request("pi", false);
+    assert!(state
+        .handle_endpoint_result(
+            "boot-1",
+            &id,
+            Err(ClientShellEndpointError {
+                code: Some("tab_create_failed".into()),
+                message: "failed".into(),
+            })
+        )
+        .1
+        .is_empty());
+}
+
+#[test]
+fn new_tab_command_on_older_server_reports_unsupported_without_sending_input() {
+    let (mut state, id) = create_request("pi", false);
+    state.set_endpoint_methods(Some(vec!["tab.create".into()]));
+    let (repaint, actions) = state.handle_endpoint_result("boot-1", &id, Ok(created_tab()));
+    assert!(repaint);
+    assert!(actions.is_empty());
+    assert!(state
+        .visible_endpoint_notice
+        .as_ref()
+        .unwrap()
+        .body
+        .contains("pane.send_input"));
+}
+
+#[test]
+fn new_tab_command_reloads_from_local_config() {
+    let mut config = ClientShellConfig::from_config(&Config::default());
+    assert!(config.new_tab_command.is_empty());
+    let updated: Config = toml::from_str("[ui]\nnew_tab_command = 'pi'").unwrap();
+    config.apply_live_config(&updated, &[], &[]);
+    assert_eq!(config.new_tab_command, "pi");
+    let updated: Config = toml::from_str("[ui]\nprompt_new_tab_command = true").unwrap();
+    config.apply_live_config(&updated, &[], &[]);
+    assert!(config.prompt_new_tab_command);
+}
+
+#[test]
+fn new_tab_picker_creates_only_after_confirmation_and_runs_selected_command() {
+    for (keys, command) in [
+        (b"\r".as_slice(), "pi"),
+        (b"\x1b[B\r".as_slice(), "claude"),
+        (b"\x1b[B\x1b[B\r".as_slice(), ""),
+    ] {
+        let (mut state, _) = create_request("", false);
+        state.config.prompt_new_tab_command = true;
+        let mut outcome = ClientShellInput::default();
+        state.record_binding(
+            crate::input::KeybindMatch::Action(crate::input::KeybindAction::NewTab),
+            &mut outcome,
+        );
+        assert!(outcome.actions.is_empty());
+        assert!(matches!(
+            state.overlay,
+            Some(ClientShellOverlay::Rename(ClientRenameOverlay {
+                target: ClientRenameTarget::LaunchTab { .. },
+                ..
+            }))
+        ));
+        let outcome = state.handle_input_bytes(keys);
+        let [ClientShellAction::Endpoint { request, .. }] = &outcome.actions[..] else {
+            panic!("expected tab creation");
+        };
+        let id = request.id.clone();
+        let (_, actions) = state.handle_endpoint_result("boot-1", &id, Ok(created_tab()));
+        if command.is_empty() {
+            assert!(actions.is_empty());
+        } else {
+            assert!(
+                matches!(&actions[..], [ClientShellAction::Endpoint { request, .. }]
+                if matches!(&request.method, Method::PaneSendInput(params) if params.pane_id == "new-pane" && params.text == command))
+            );
+        }
+    }
+}
+
+#[test]
+fn new_tab_picker_cancel_does_not_create_a_tab() {
+    let (mut state, _) = create_request("", false);
+    state.config.prompt_new_tab_command = true;
+    let mut outcome = ClientShellInput::default();
+    state.record_binding(
+        crate::input::KeybindMatch::Action(crate::input::KeybindAction::NewTab),
+        &mut outcome,
+    );
+    assert!(outcome.actions.is_empty());
+    let outcome = state.handle_input_bytes(b"\x1b");
+    assert!(outcome.actions.is_empty());
+    assert!(state.overlay.is_none());
+}

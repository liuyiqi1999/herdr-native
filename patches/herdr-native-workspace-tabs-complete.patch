index 0000000..2b326f7
--- /dev/null
+++ b/src/client/shell/remote_agents.rs
@@ -0,0 +1,95 @@
+use super::*;
+
+// Client presentation only: the connector uses the existing public JSON CLI/API,
+// including operations that older servers do not expose on the TUI endpoint.
+impl ClientShellState {
+    pub(super) fn begin_native_agent(&mut self, agent: &str, outcome: &mut ClientShellInput) {
+        let Ok(launcher) = std::env::var("HERDR_REMOTE_LAUNCHER") else {
+            self.set_endpoint_error("Open Herdr Native to use local remote-agent editing");
+            outcome.repaint = true;
+            return;
+        };
+        self.prepare_native_agent(agent, &launcher, outcome);
+    }
+
+    pub(super) fn prepare_native_agent(
+        &mut self,
+        agent: &str,
+        launcher: &str,
+        outcome: &mut ClientShellInput,
+    ) {
+        if agent == "pi" || agent == "claude" {
+            let remote = if !self.active_endpoint_id.is_local() {
+                Some(self.active_endpoint_id.clone())
+            } else {
+                let candidates = self
+                    .endpoints
+                    .iter()
+                    .filter(|endpoint| {
+                        !endpoint.endpoint_id.is_local()
+                            && endpoint.status == ClientEndpointStatus::Online
+                    })
+                    .collect::<Vec<_>>();
+                (candidates.len() == 1).then(|| candidates[0].endpoint_id.clone())
+            };
+            let Some(ClientEndpointId::Ssh(profile)) = remote else {
+                self.set_endpoint_error("Select the remote machine for this agent first");
+                outcome.repaint = true;
+                return;
+            };
+            let mut args = vec![
+                "open".into(),
+                "--agent".into(),
+                agent.into(),
+                "--machine".into(),
+                profile.to_string(),
+            ];
+            if self.active_endpoint_id == ClientEndpointId::Ssh(profile.clone()) {
+                if let Some(cwd) = self.snapshot.as_deref().and_then(|snapshot| {
+                    snapshot
+                        .panes
+                        .iter()
+                        .find(|pane| Some(&pane.pane_id) == snapshot.focused_pane_id.as_ref())
+                        .and_then(|pane| pane.foreground_cwd.as_ref().or(pane.cwd.as_ref()))
+                }) {
+                    args.extend(["--cwd".into(), cwd.clone()]);
+                }
+            }
+            self.activate_endpoint(ClientEndpointId::Ssh(profile), outcome);
+            outcome.actions.push(ClientShellAction::OpenNativeAgent {
+                launcher: launcher.into(),
+                args,
+            });
+            outcome.repaint = true;
+            return;
+        }
+        if !self.endpoint_is_online(&ClientEndpointId::Local) {
+            self.set_endpoint_error(
+                "Local endpoint is not ready; remote sessions were not changed",
+            );
+            outcome.repaint = true;
+            return;
+        }
+        let mut args = vec!["open".into(), "--agent".into(), agent.into()];
+        if let ClientEndpointId::Ssh(profile) = &self.active_endpoint_id {
+            args.extend(["--machine".into(), profile.to_string()]);
+            if let Some(cwd) = self.snapshot.as_deref().and_then(|snapshot| {
+                snapshot
+                    .panes
+                    .iter()
+                    .find(|pane| Some(&pane.pane_id) == snapshot.focused_pane_id.as_ref())
+                    .and_then(|pane| pane.foreground_cwd.as_ref().or(pane.cwd.as_ref()))
+            }) {
+                args.extend(["--cwd".into(), cwd.clone()]);
+            }
+        }
+        // Use the regular source-off-first endpoint handoff. Never send commands to
+        // whichever remote pane happened to have focus when this action was clicked.
+        self.activate_endpoint(ClientEndpointId::Local, outcome);
+        outcome.actions.push(ClientShellAction::OpenNativeAgent {
+            launcher: launcher.into(),
+            args,
+        });
+        outcome.repaint = true;
+    }
+}

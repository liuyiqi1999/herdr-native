+use super::*;
+
+#[test]
+fn workspace_tabs_keep_remote_shell_targets_separate() {
+    let (state, remote) = state_with_remote();
+    let rows = crate::client::shell::tab_sidebar::endpoint_rows(
+        &state.endpoints,
+        &state.active_endpoint_id,
+    );
+    assert_eq!(rows.len(), 4);
+    let area = Rect::new(0, 0, 40, 10);
+    let mut buffer = Buffer::empty(area);
+    let mut hits = ShellHitMap::default();
+    crate::client::shell::tab_sidebar::render(
+        &mut buffer,
+        area,
+        &rows,
+        &state.config,
+        &mut 0,
+        &mut hits,
+    );
+    assert_eq!(hits.endpoint_agents.len(), 2);
+    assert_eq!(hits.endpoint_agents[0].1, ClientEndpointId::Local);
+    assert_eq!(hits.endpoint_agents[1].1, remote);
+    assert_eq!(hits.endpoint_agents[0].2, "pane_1");
+    assert_eq!(hits.endpoint_agents[1].2, "pane_1");
+    assert!(hits.agents.is_empty());
+}

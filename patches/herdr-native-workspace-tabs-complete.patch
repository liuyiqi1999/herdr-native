+fn pi_session_title(raw: &str) -> Option<&str> {
+    // Pi emits “π - session name - cwd”; the unnamed form has only cwd.
+    // Recognize the title itself so RPC adapters also work without process detection.
+    let rest = raw
+        .strip_prefix("π - ")
+        .or_else(|| raw.strip_prefix("pi - "))?;
+    let (name, _) = rest.rsplit_once(" - ")?;
+    let name = name.trim();
+    (!name.is_empty()).then_some(name)
+}

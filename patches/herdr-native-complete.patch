diff --git a/src/client/shell/native_editor.rs b/src/client/shell/native_editor.rs
new file mode 100644
index 0000000..5c6e48e
--- /dev/null
+++ b/src/client/shell/native_editor.rs
@@ -0,0 +1,362 @@
+//! Client-only bridge for Pi's explicitly marked editor. No server codec changes.
+use super::*;
+use base64::Engine;
+use std::io::{BufRead, BufReader, Write};
+use std::sync::{mpsc, Arc, Mutex};
+
+const MARKER: &str = "https://herdr-native.invalid/editor/v1/";
+
+#[derive(Default)]
+pub(super) struct NativeEditors {
+    pub targets: HashMap<String, String>,
+    bridges: HashMap<String, EditorBridge>,
+    active: Option<(String, String, Rect)>,
+    endpoint: Option<ClientEndpointId>,
+}
+
+struct EditorBridge {
+    child: std::process::Child,
+    input: mpsc::Sender<String>,
+    latest: Arc<Mutex<Option<EditorFrame>>>,
+    frame: Option<FrameData>,
+    ready: bool,
+    preserve_top: bool,
+    size: (u16, u16),
+    encoder: crate::pane::terminal::GhosttyPaneTerminal,
+}
+
+#[derive(serde::Deserialize)]
+struct EditorFrame {
+    width: u16,
+    lines: Vec<String>,
+    cursor: Option<(u16, u16)>,
+    ready: bool,
+    #[serde(default)]
+    preserve_top: bool,
+}
+
+impl Drop for EditorBridge {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+fn terminal(
+    cols: u16,
+    rows: u16,
+    bytes: &[u8],
+) -> Option<crate::pane::terminal::GhosttyPaneTerminal> {
+    let mut terminal = crate::ghostty::Terminal::new(cols, rows, 0).ok()?;
+    terminal.write(bytes);
+    let (sender, _) = tokio::sync::mpsc::channel(1);
+    crate::pane::terminal::GhosttyPaneTerminal::new(terminal, sender).ok()
+}
+
+fn editor_frame(frame: &EditorFrame) -> Option<FrameData> {
+    if frame.width == 0 || frame.width > 500 || frame.lines.is_empty() || frame.lines.len() > 200 {
+        return None;
+    }
+    let height = frame.lines.len() as u16;
+    let mut ansi = String::from("\x1b[?7l");
+    for (index, line) in frame.lines.iter().enumerate() {
+        if line.len() > 65536 {
+            return None;
+        }
+        ansi.push_str(&format!("\x1b[{};1H\x1b[0m{}", index + 1, line));
+    }
+    let pane = terminal(frame.width, height, ansi.as_bytes())?;
+    let mut renderer =
+        ratatui::Terminal::new(ratatui::backend::TestBackend::new(frame.width, height)).ok()?;
+    renderer
+        .draw(|view| pane.render(view, Rect::new(0, 0, frame.width, height), false))
+        .ok()?;
+    let mut output =
+        FrameData::from_ratatui_buffer_with_hyperlinks(renderer.backend().buffer(), None, &[]);
+    if let Some((x, y)) = frame
+        .cursor
+        .filter(|(x, y)| *x < frame.width && *y < height)
+    {
+        output.cursor = Some(crate::protocol::CursorState {
+            x,
+            y,
+            visible: true,
+            shape: 2,
+        });
+    }
+    Some(output)
+}
+
+impl EditorBridge {
+    fn spawn(launcher: &str, machine: &str, socket: &str, cwd: &str) -> Option<Self> {
+        let mut child = std::process::Command::new(launcher)
+            .args([
+                "editor", "--host", machine, "--socket", socket, "--cwd", cwd,
+            ])
+            .stdin(std::process::Stdio::piped())
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::null())
+            .spawn()
+            .ok()?;
+        let mut stdin = child.stdin.take()?;
+        let stdout = child.stdout.take()?;
+        let (input, receiver) = mpsc::channel::<String>();
+        std::thread::spawn(move || {
+            for line in receiver {
+                if writeln!(stdin, "{line}").is_err() || stdin.flush().is_err() {
+                    break;
+                }
+            }
+        });
+        let latest = Arc::new(Mutex::new(None));
+        let frames = latest.clone();
+        std::thread::spawn(move || {
+            for line in BufReader::new(stdout).lines().map_while(Result::ok) {
+                if line.len() > 4 * 1024 * 1024 {
+                    break;
+                }
+                if let Ok(frame) = serde_json::from_str::<EditorFrame>(&line) {
+                    if let Ok(mut slot) = frames.lock() {
+                        *slot = Some(frame);
+                    }
+                }
+            }
+        });
+        Some(Self {
+            child,
+            input,
+            latest,
+            frame: None,
+            ready: false,
+            preserve_top: false,
+            size: (0, 0),
+            encoder: terminal(1, 1, b"\x1b[>1u")?,
+        })
+    }
+    fn send(&self, value: serde_json::Value) -> bool {
+        self.input.send(value.to_string()).is_ok()
+    }
+    fn poll(&mut self, width: u16, height: u16) -> bool {
+        if self.size != (width, height) {
+            self.size = (width, height);
+            self.send(serde_json::json!({"type":"size", "width":width, "height":height}));
+        }
+        let update = self.latest.lock().ok().and_then(|mut slot| slot.take());
+        if let Some(update) = update {
+            if let Some(frame) = editor_frame(&update) {
+                self.frame = Some(frame);
+                self.ready = update.ready;
+                self.preserve_top = update.preserve_top;
+                return true;
+            }
+        }
+        false
+    }
+}
+
+impl NativeEditors {
+    pub fn active(&self) -> bool {
+        self.active.is_some()
+    }
+
+    fn sync(
+        &mut self,
+        endpoint: &ClientEndpointId,
+        snapshot: &ClientShellSnapshot,
+        surface: &PaneSurfaceFrame,
+    ) -> bool {
+        self.active = None;
+        self.endpoint = Some(endpoint.clone());
+        let ClientEndpointId::Ssh(profile) = endpoint else {
+            return false;
+        };
+        let Some(machine) = self.targets.get(&profile.to_string()) else {
+            return false;
+        };
+        if surface.popup.is_some() {
+            return false;
+        }
+        let Some(pane) = surface.panes.iter().find(|pane| pane.focused) else {
+            return false;
+        };
+        if pane
+            .scroll
+            .is_some_and(|scroll| scroll.offset_from_bottom > 0)
+        {
+            return false;
+        }
+        let bounds = pane.inner_rect;
+        let mut marked = None;
+        // Parse only explicitly marked hyperlinks and only the focused pane's rows.
+        for (link, uri) in surface.frame.hyperlinks.iter().enumerate() {
+            let Some(encoded) = uri.strip_prefix(MARKER) else {
+                continue;
+            };
+            let Some(socket) = base64::engine::general_purpose::URL_SAFE_NO_PAD
+                .decode(encoded)
+                .ok()
+                .and_then(|bytes| String::from_utf8(bytes).ok())
+            else {
+                continue;
+            };
+            if !socket.starts_with("/tmp/hn-editor-")
+                || !socket.ends_with("/editor.sock")
+                || socket.contains("..")
+            {
+                continue;
+            }
+            let mut first = None;
+            let mut last = 0;
+            for y in bounds.y..bounds.y.saturating_add(bounds.height) {
+                let start =
+                    usize::from(y) * usize::from(surface.frame.width) + usize::from(bounds.x);
+                let end = start + usize::from(bounds.width);
+                if surface
+                    .frame
+                    .cells
+                    .get(start..end)
+                    .is_some_and(|row| row.iter().any(|cell| cell.hyperlink == Some(link as u32)))
+                {
+                    first.get_or_insert(y);
+                    last = y;
+                }
+            }
+            if let Some(first) = first {
+                marked = Some((
+                    socket,
+                    Rect::new(bounds.x, first, bounds.width, last - first + 1),
+                ));
+                break;
+            }
+        }
+        let Some((socket, rect)) = marked else {
+            return false;
+        };
+        let key = format!("{machine}:{socket}");
+        if !self.bridges.contains_key(&key) {
+            let Ok(launcher) = std::env::var("HERDR_REMOTE_LAUNCHER") else {
+                return false;
+            };
+            let cwd = snapshot
+                .panes
+                .iter()
+                .find(|entry| entry.pane_id == pane.pane_id)
+                .and_then(|entry| entry.foreground_cwd.as_deref().or(entry.cwd.as_deref()))
+                .unwrap_or("/");
+            let Some(bridge) = EditorBridge::spawn(&launcher, machine, &socket, cwd) else {
+                return false;
+            };
+            self.bridges.insert(key.clone(), bridge);
+        }
+        self.active = Some((key.clone(), pane.pane_id.clone(), rect));
+        self.bridges
+            .get_mut(&key)
+            .is_some_and(|bridge| bridge.poll(rect.width, bounds.height))
+    }
+
+    pub fn intercept(&self, request: &ClientMessage) -> bool {
+        let Some((key, pane, _)) = &self.active else {
+            return false;
+        };
+        let Some(bridge) = self.bridges.get(key).filter(|bridge| bridge.ready) else {
+            return false;
+        };
+        let ClientMessage::ClientShellPaneInput { pane_id, events } = request else {
+            return false;
+        };
+        if pane_id != pane
+            || events
+                .iter()
+                .any(|event| matches!(event, ClientPaneInputEvent::Mouse { .. }))
+        {
+            return false;
+        }
+        for event in events {
+            let bytes = match event.to_raw_input_event() {
+                crate::raw_input::RawInputEvent::Key(key) => {
+                    bridge.encoder.encode_terminal_key(key)
+                }
+                crate::raw_input::RawInputEvent::Paste(text) => {
+                    format!("\x1b[200~{text}\x1b[201~").into_bytes()
+                }
+                crate::raw_input::RawInputEvent::Text(text) => text.into_string().into_bytes(),
+                _ => continue,
+            };
+            bridge
+                .send(serde_json::json!({"type":"input", "data":String::from_utf8_lossy(&bytes)}));
+        }
+        true
+    }
+
+    pub fn blit(&self, frame: &mut FrameData, origin: Rect) {
+        let Some((key, _, rect)) = &self.active else {
+            return;
+        };
+        let Some(source) = self
+            .bridges
+            .get(key)
+            .filter(|bridge| bridge.ready)
+            .and_then(|bridge| bridge.frame.as_ref())
+        else {
+            return;
+        };
+        if source.width != rect.width || source.height > rect.bottom() {
+            return;
+        }
+        let x = origin.x + rect.x;
+        let y = origin.y + rect.bottom() - source.height;
+        if x + source.width > frame.width || y + source.height > frame.height {
+            return;
+        }
+        let top_start = usize::from(origin.y + rect.y) * usize::from(frame.width) + usize::from(x);
+        let original_top = frame
+            .cells
+            .get(top_start..top_start + usize::from(source.width))
+            .map(|row| row.to_vec());
+        for row in 0..source.height {
+            let dst = usize::from(y + row) * usize::from(frame.width) + usize::from(x);
+            let src = usize::from(row) * usize::from(source.width);
+            frame.cells[dst..dst + usize::from(source.width)]
+                .clone_from_slice(&source.cells[src..src + usize::from(source.width)]);
+        }
+        if let Some(top) = original_top.filter(|_| {
+            self.bridges
+                .get(key)
+                .is_some_and(|bridge| bridge.preserve_top)
+        }) {
+            let start = usize::from(y) * usize::from(frame.width) + usize::from(x);
+            frame.cells[start..start + top.len()].clone_from_slice(&top);
+        }
+        frame.cursor = source.cursor.clone().map(|mut cursor| {
+            cursor.x += x;
+            cursor.y += y;
+            cursor
+        });
+    }
+}
+
+impl ClientShellState {
+    pub(crate) fn tick_native_editor(&mut self) -> bool {
+        if self.pane_surface_generation != self.active_snapshot_generation {
+            self.native_editors.active = None;
+            return false;
+        }
+        match (self.snapshot.as_deref(), self.pane_surface.as_ref()) {
+            (Some(snapshot), Some(surface)) if snapshot.revision == surface.projection_revision => {
+                self.native_editors
+                    .sync(&self.active_endpoint_id, snapshot, surface)
+            }
+            _ => {
+                self.native_editors.active = None;
+                false
+            }
+        }
+    }
+    pub(crate) fn native_editor_input(&self, request: &ClientMessage) -> bool {
+        self.mode == ClientShellMode::Terminal
+            && self.overlay.is_none()
+            && self.native_editors.endpoint.as_ref() == Some(&self.active_endpoint_id)
+            && self.pane_surface.is_some()
+            && self.native_editors.intercept(request)
+    }
+}
